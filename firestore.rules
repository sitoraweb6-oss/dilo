rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // অ্যাকাউন্ট active না হলে (pending/rejected/inactive) কোনো অ্যাডমিন ক্ষমতা নেই
    function isActiveAccount() {
      return userDoc().get('status', 'active') == 'active';
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isActiveAccount() && (
          userDoc().role in ['admin', 'super_admin', 'Admin', 'Super Admin', 'SUPER_ADMIN'] ||
          ('permissions' in userDoc() && (
            userDoc().permissions.hasAny(['admin', 'super_admin', 'Admin', 'Super Admin'])
          ))
        );
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isActiveAccount() && (
          userDoc().role in ['super_admin', 'Super Admin', 'SUPER_ADMIN'] ||
          ('permissions' in userDoc() && userDoc().permissions.hasAny(['super_admin', 'Super Admin']))
        );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // একজন ইউজার একবারই ভোট দিতে পারবে, অন্যের ভোট মুছতে পারবে না
    function isOwnNewVote() {
      let before = resource.data.get('votedUserIds', []);
      let after = request.resource.data.votedUserIds;
      return !(request.auth.uid in before) &&
             request.auth.uid in after &&
             after.hasAll(before) &&
             after.size() == before.size() + 1;
    }

    function isMemberUpdate(paymentId) {
      let isOwner = request.auth.uid == resource.data.userId;
      let isPending = resource.data.status == 'pending';
      let unchangedStatus = request.resource.data.status == resource.data.status;
      let unchangedApproval = (!('firstApprovedBy' in resource.data) && !('firstApprovedBy' in request.resource.data)) ||
                              (request.resource.data.firstApprovedBy == resource.data.firstApprovedBy);
      let unchangedCore = request.resource.data.amount == resource.data.amount &&
                          request.resource.data.month == resource.data.month &&
                          request.resource.data.nameId == resource.data.nameId &&
                          request.resource.data.paymentType == resource.data.paymentType;
      return isOwner && isPending && unchangedStatus && unchangedApproval && unchangedCore;
    }

    function isAdminApproval(paymentId) {
      let isOwner = request.auth.uid == resource.data.userId;
      let statusChangedToLevel1 = resource.data.status == 'pending' && request.resource.data.status == 'level_1_approved';
      let statusChangedToApproved = resource.data.status == 'level_1_approved' && request.resource.data.status == 'approved';
      let statusChangedToRejected = request.resource.data.status == 'rejected';
      
      let validLevel1 = statusChangedToLevel1 && 
                        request.resource.data.firstApprovedBy == request.auth.uid &&
                        (!('secondApprovedBy' in request.resource.data) || request.resource.data.secondApprovedBy == null);
                        
      let validLevel2 = statusChangedToApproved && 
                        (!('firstApprovedBy' in resource.data) || request.resource.data.firstApprovedBy == resource.data.firstApprovedBy) &&
                        request.resource.data.secondApprovedBy == request.auth.uid &&
                        (!('firstApprovedBy' in resource.data) || request.auth.uid != resource.data.firstApprovedBy);

      return isAdmin() && !isOwner && (validLevel1 || validLevel2 || statusChangedToRejected);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // নতুন ইউজার শুধু member + pending_approval হিসেবেই ঢুকতে পারবে
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.role == 'member' &&
        request.resource.data.status == 'pending_approval' &&
        !('permissions' in request.resource.data);
      allow update: if isAuthenticated() && (
        // নিজের প্রোফাইল: role/permissions/status/slot নিজে বদলানো যাবে না
        (request.auth.uid == userId &&
          !changedKeys().hasAny(['role', 'permissions', 'status', 'names', 'migratedTo'])) ||
        // অ্যাডমিন: সাধারণ আপডেট (approve, reject, slot ইত্যাদি)
        (isAdmin() && !changedKeys().hasAny(['role', 'permissions'])) ||
        // role বা permissions বদলাতে পারবে শুধু সুপার অ্যাডমিন
        isSuperAdmin()
      );
      allow delete: if isAdmin();
    }
    
    match /usersPrivate/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId && request.resource.data.status == 'pending';
      allow update: if isMemberUpdate(paymentId) || isAdminApproval(paymentId);
      allow delete: if isAdmin();
    }
    
    match /yearlyPayments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId && request.resource.data.status == 'pending';
      allow update: if isMemberUpdate(paymentId) || isAdminApproval(paymentId);
      allow delete: if isAdmin();
    }
    
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && isActiveAccount() &&
        changedKeys().hasOnly(['options', 'votedUserIds']) &&
        isOwnNewVote()
      );
    }
    
    match /activityLog/{logId} {
      allow read, create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    match /communityMessages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    match /adminSupportMessages/{messageId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.fromUserId || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.fromUserId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /hadiths/{hadithId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /photoCarousel/{photoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /profileChangeRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.memberUid;
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      // হিসাব শুরুর মাস (ledgerStartMonth) বদলাতে পারবে শুধু সুপার অ্যাডমিন
      allow create: if isAdmin() && (!('ledgerStartMonth' in request.resource.data) || request.resource.data.ledgerStartMonth == null || isSuperAdmin());
      allow update: if isAdmin() && (!changedKeys().hasAny(['ledgerStartMonth']) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }
    
    match /adminRequests/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /slotRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }



    match /investments/{investmentId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && isActiveAccount() &&
        changedKeys().hasOnly(['votedUserIds', 'totalVotes', 'approveVotes', 'rejectVotes', 'opinions']) &&
        isOwnNewVote() &&
        request.resource.data.totalVotes == resource.data.get('totalVotes', 0) + 1
      );
    }
    match /investmentTransactions/{txnId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /accountMigrations/{migrationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.requestedBy;
      allow update, delete: if isAdmin();
    }
    match /pinRecoveryRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin() && request.auth.uid != resource.data.userId;
      allow delete: if isAdmin();
    }
  }
}
